{
  "name": "vsl-ep-coaching",
  "version": "1.0.0",
  "description": "VSL EP Coaching (motion design, Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/fonts": "4.0.537",
    "@remotion/install-whisper-cpp": "4.0.537",
    "@remotion/layout-utils": "4.0.537",
    "@remotion/media": "4.0.537",
    "@remotion/motion-blur": "4.0.537",
    "@remotion/noise": "4.0.537",
    "@remotion/paths": "4.0.537",
    "@remotion/transitions": "4.0.537",
    "mediabunny": "1.61.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "timeline": "node scripts/timeline.mjs",
    "prep": "node scripts/prep.mjs",
    "sons": "node scripts/sons.mjs",
    "musique": "node scripts/musique.mjs",
    "vtt": "node scripts/vtt.mjs",
    "caler": "node scripts/caler.mjs",
    "voix-ia": "node scripts/voix-ia.mjs",
    "planche": "node scripts/planche.mjs",
    "preparer": "npm run timeline && npm run prep && npm run sons && npm run musique && npm run vtt",
    "dev": "npm run prep && remotion studio",
    "stills": "npm run prep && remotion render VSL out/stills --frames=150,1500,3000,6000,9000,12000,15000,18000,20500 --image-format=jpeg",
    "rendu": "npm run preparer && remotion render VSL out/vsl-ep-coaching.mp4 --codec=h264 --crf=18",
    "rendu:720": "npm run preparer && remotion render VSL out/vsl-ep-coaching-720p.mp4 --codec=h264 --crf=20 --scale=0.6666667",
    "web": "node scripts/web.mjs",
    "build": "remotion bundle",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
